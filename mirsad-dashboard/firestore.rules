rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  قواعد أمان «قياس اتجاه المتعلمين ١٤٤٨هـ»
//  الابتدائية الخامسة والستون بعد المائة
//
//  المبدأ: الفصل بين القياس العام والإدارة يتحقّق هنا في طبقة
//  البيانات، لا بإخفاء أزرار في الواجهة. كل قاعدة هنا مغطّاة
//  باختبار فعلي في scripts/firestore/rules.test.mjs.
//
//  ثلاث ممنوعات ثابتة لا تُخترق من الواجهة:
//    ١) أسماء الطالبات لا تُقرأ إلا بصلاحية إدارة.
//    ٢) لا حذف نهائي لطالبة ولا لاستجابة — إطلاقًا.
//    ٣) القياس العام يكتب استجابته ولا يقرأ استجابة أحد.
//
//  هذه القواعد تخص مشروع Firebase المعرّف في .firebaserc داخل هذا
//  المجلد وحده، ولا تشترك مع أي مشروع آخر.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    /**
     * حسابات الإدارة، بمعرّفاتها الثابتة من Firebase Authentication.
     *
     * اخترنا المعرّف بدل الادّعاء المخصّص (custom claim) عمدًا: منح
     * الادّعاء يحتاج مفتاح خدمة سرّيًا يخرج من يد المدرسة، أما المعرّف
     * فيُقرأ من لوحة Firebase علنًا ولا يصلح وحده للدخول — الدخول يبقى
     * بالبريد وكلمة المرور، وكلمة المرور لا يعرفها إلا صاحبتها.
     *
     * لإضافة حساب إدارة: أضيفي معرّفه إلى هذه القائمة وأعيدي رفع القواعد.
     */
    function adminUids() {
      return [
        'ADMIN_UID_PLACEHOLDER'
      ];
    }

    function isAdmin() {
      return signedIn()
        && (request.auth.uid in adminUids() || request.auth.token.admin == true);
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ───── مرجعيات القياس (غير شخصية) ─────
    // أسماء الصفوف والفصول والأسئلة وحدها: لا تكشف هوية أي طالبة.

    match /grades/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /options/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cycles/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /meta/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ───── الطالبات: بيانات شخصية لقاصرات ─────
    // القراءة للإدارة وحدها. القياس العام لا يرى القائمة إطلاقًا،
    // بل تكتب الطالبة اسمها وتُطابقه الإدارة لاحقًا في شاشة المطابقة.
    match /students/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin();
      // لا حذف نهائي إطلاقًا — الأرشفة تتم بتعديل الحقل status
      allow delete: if false;
    }

    // ───── الاستجابات ─────
    // تُكتب من القياس العام بلا قراءة، وتُقرأ للإدارة وحدها.

    // الشكل الذي يُسمح للقياس العام بكتابته، حرفًا بحرف:
    // لا يربط نفسه بطالبة، ولا يدّعي مطابقة، ولا يضع علامة مراجعة.
    function publicResponse(d) {
      return d.keys().hasAll([
          'cycleId', 'rawName', 'declaredGradeId', 'classId', 'matchStatus',
          'studentId', 'candidateStudentIds', 'duplicateFlag', 'source',
          'submittedAt', 'reviewedAt', 'reviewedBy', 'answers'
        ])
        && d.keys().hasOnly([
          'cycleId', 'rawName', 'declaredGradeId', 'classId', 'matchStatus',
          'studentId', 'candidateStudentIds', 'duplicateFlag', 'source',
          'submittedAt', 'reviewedAt', 'reviewedBy', 'answers', 'clientToken'
        ])
        && d.cycleId is string && d.cycleId.size() > 0
        && d.rawName is string && d.rawName.size() >= 2 && d.rawName.size() <= 120
        && (d.declaredGradeId == null || d.declaredGradeId is string)
        && (d.classId == null || d.classId is string)
        && d.answers is list && d.answers.size() > 0 && d.answers.size() <= 100
        && d.submittedAt is string && d.submittedAt.size() > 0
        // لا يملك القياس العام أن يربط نفسه بطالبة ولا أن يدّعي مطابقة
        && d.studentId == null
        && d.matchStatus == 'NEW'
        && d.candidateStudentIds is list && d.candidateStudentIds.size() == 0
        && d.duplicateFlag == false
        && d.source == 'web'
        && d.reviewedAt == null
        && d.reviewedBy == null;
    }

    // لا تُقبل استجابة إلا في دورة قياس مفتوحة فعلًا.
    function cycleOpen(cycleId) {
      return exists(/databases/$(database)/documents/cycles/$(cycleId))
        && get(/databases/$(database)/documents/cycles/$(cycleId)).data.status == 'open';
    }

    match /responses/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && publicResponse(request.resource.data) && cycleOpen(request.resource.data.cycleId));
      // الاستجابة المُرسَلة لا تُعدَّل إلا من الإدارة، ولا تُحذف أبدًا:
      // الاستجابة المكرّرة تُحفظ وتُراجَع، ولا تُستبدل ولا تُمحى.
      // حتى الإدارة لا تملك تغيير نص الإجابات نفسها.
      allow update: if isAdmin() && unchanged('answers') && unchanged('rawName');
      allow delete: if false;
    }

    // ───── بيانات إدارية بحتة ─────

    match /suggestions/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if false;
    }

    match /improvementActions/{id} {
      allow read, write: if isAdmin();
    }

    match /categories/{id} {
      allow read, write: if isAdmin();
    }

    match /reviewAcks/{id} {
      allow read, write: if isAdmin();
    }

    // سجل العمليات: يُكتب ولا يُعدَّل ولا يُحذف
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // كل ما عدا ذلك مرفوض افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
