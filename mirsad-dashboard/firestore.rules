rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  قواعد أمان «قياس اتجاه المتعلمين»
//  الابتدائية الخامسة والستون بعد المائة
//
//  المبدأ: الفصل الفعلي بين القياس العام والإدارة يتحقّق هنا في
//  طبقة البيانات، لا بإخفاء أزرار في الواجهة.
//
//  • القياس العام: يقرأ ما يلزم لإتمام القياس فقط (الصفوف والفصول
//    وأسماء الطالبات والأسئلة)، ويكتب استجابته ولا يقرأ استجابة أحد.
//  • الإدارة: حساب يحمل الادّعاء المخصّص admin == true.
//
//  هذه القواعد تخص مشروع Firebase المعرّف في .firebaserc داخل هذا
//  المجلد وحده، ولا تشترك مع أي مشروع آخر.
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // ───── مرجعيات يحتاجها القياس العام للعرض ─────
    // تُقرأ للمصادَق لهم (ولو بحساب مجهول) وتُكتب من الإدارة وحدها.

    match /grades/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /classes/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /questions/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /cycles/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // أسماء الطالبات تظهر في قائمة اختيار القياس، فتُقرأ للمصادَق لهم.
    // لا يجوز للقياس العام إنشاؤها ولا تعديلها ولا حذفها.
    match /students/{id} {
      allow read: if signedIn();
      allow create, update: if isAdmin();
      // لا حذف نهائي إطلاقًا — الأرشفة تتم بتعديل الحقل status
      allow delete: if false;
    }

    // ───── الاستجابات ─────
    // تُكتب من القياس العام بلا قراءة، وتُقرأ للإدارة وحدها.

    function validResponse(d) {
      return d.keys().hasAll(['cycleId', 'studentId', 'answers', 'submittedAt'])
        && d.cycleId is string
        && d.studentId is string
        && d.answers is list
        && d.answers.size() > 0
        && d.answers.size() <= 100
        && d.submittedAt is string;
    }

    match /responses/{id} {
      allow read: if isAdmin();
      allow create: if signedIn() && validResponse(request.resource.data);
      // الاستجابة المُرسَلة لا تُعدَّل إلا من الإدارة، ولا تُحذف أبدًا:
      // الاستجابة المكرّرة تُحفظ وتُراجَع، ولا تُستبدل ولا تُمحى.
      allow update: if isAdmin() && unchanged('answers');
      allow delete: if false;
    }

    // ───── بيانات إدارية بحتة ─────

    match /suggestions/{id} {
      allow read, write: if isAdmin();
      allow delete: if false;
    }

    match /improvementActions/{id} {
      allow read, write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // سجل العمليات: يُكتب ولا يُعدَّل ولا يُحذف
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // كل ما عدا ذلك مرفوض افتراضيًا
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
