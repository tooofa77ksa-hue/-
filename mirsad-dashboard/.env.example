# ─────────────────────────────────────────────────────────────
#  قياس اتجاه المتعلمين ١٤٤٨هـ — متغيّرات البيئة
#  الابتدائية الخامسة والستون بعد المائة
#
#  انسخ هذا الملف إلى .env ثم املأ القيم.
#
#  مهم: هذه القيم تخص مشروع Firebase الخاص بهذا النظام وحده.
#  البادئة VITE_MIRSAD_ مختارة عمدًا حتى لا تتصادم مع أي إعداد آخر.
#
#  إن تركت قيم Firebase فارغة، يعمل النظام بوضع التخزين المحلي
#  (localStorage) على بيانات المصدر المستوردة، دون أي اتصال بالشبكة.
# ─────────────────────────────────────────────────────────────

VITE_MIRSAD_FIREBASE_API_KEY=
VITE_MIRSAD_FIREBASE_AUTH_DOMAIN=
VITE_MIRSAD_FIREBASE_PROJECT_ID=
VITE_MIRSAD_FIREBASE_STORAGE_BUCKET=
VITE_MIRSAD_FIREBASE_MESSAGING_SENDER_ID=
VITE_MIRSAD_FIREBASE_APP_ID=

# اضبطها على true لتوصيل النظام بمحاكي Firestore المحلي (المنفذ 8181)
VITE_MIRSAD_USE_EMULATOR=false

# رمز دخول لوحة الإدارة.
# تنبيه: هذا الرمز يمنع الوصول العَرَضي فقط لأنه يُفحص في المتصفح.
# الحماية الفعلية للبيانات تأتي من قواعد firestore.rules عند تفعيل
# Firebase، حيث تُشترط صلاحية admin على حساب الإدارة.
VITE_MIRSAD_ADMIN_PASSCODE=
