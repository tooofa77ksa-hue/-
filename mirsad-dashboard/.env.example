# ─────────────────────────────────────────────────────────────
#  مرصد — متغيرات البيئة
#  انسخ هذا الملف إلى .env ثم املأ القيم.
#
#  مهم: هذه القيم تخص مشروع Firebase الخاص بـ"مرصد" وحده.
#  لا تستخدم هنا مفاتيح أي مشروع آخر — البادئة VITE_MIRSAD_
#  مختارة عمدًا حتى لا تتصادم مع أي إعداد سابق.
#
#  إن تركت هذه القيم فارغة، يعمل التطبيق تلقائيًا بوضع
#  التخزين المحلي (localStorage) دون أي اتصال بـ Firebase.
# ─────────────────────────────────────────────────────────────

VITE_MIRSAD_FIREBASE_API_KEY=
VITE_MIRSAD_FIREBASE_AUTH_DOMAIN=
VITE_MIRSAD_FIREBASE_PROJECT_ID=
VITE_MIRSAD_FIREBASE_STORAGE_BUCKET=
VITE_MIRSAD_FIREBASE_MESSAGING_SENDER_ID=
VITE_MIRSAD_FIREBASE_APP_ID=

# اضبطها على true لتوصيل التطبيق بمحاكي Firestore المحلي (المنفذ 8181)
VITE_MIRSAD_USE_EMULATOR=false
