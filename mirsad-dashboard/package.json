{
  "name": "qiyas-ittijah-almutaallimin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "قياس اتجاه المتعلمين 1448هـ — الابتدائية الخامسة والستون بعد المائة",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "firebase:emulate": "firebase emulators:start --only firestore,hosting",
    "firebase:deploy": "npm run build:deploy && firebase deploy --only hosting,firestore",
    "etl": "python3 scripts/etl/build_dataset.py",
    "verify": "npm run lint && tsc -b && npm run test && npm run build",
    "test:rules": "firebase emulators:exec --only firestore --project demo-qiyas-rules \"node scripts/firestore/rules.test.mjs\"",
    "verify:no-pii": "node scripts/verify/no-personal-data.mjs",
    "build:deploy": "npm run build && npm run verify:no-pii",
    "verify:all": "npm run verify && npm run test:rules && npm run test:excel && npm run test:qr && npm run test:dashboard && npm run test:improvement && npm run test:survey && npm run test:reports && npm run test:e2e",
    "test:e2e": "bash scripts/e2e/run.sh",
    "test:reports": "npm run build:test && node scripts/e2e/reports.mjs && python3 scripts/verify/excel-print.py '.e2e-out/*.xlsx' && python3 scripts/verify/excel-charts.py .e2e-out/student-voice-1448.xlsx",
    "test:survey": "npm run build:test && node scripts/e2e/survey-mobile.mjs",
    "build:test": "tsc -b && vite build --mode test",
    "test:excel": "vite-node scripts/verify/excel-charts.ts && python3 scripts/verify/excel-charts.py .tmp-excel/charts.xlsx",
    "test:qr": "vite-node scripts/verify/qr-scannable.ts && python3 scripts/verify/qr-scannable.py .tmp-excel/qr-cases.json",
    "test:dashboard": "npm run build:test && node scripts/e2e/dashboard.mjs",
    "test:improvement": "npm run build:test && node scripts/e2e/improvement.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^10.12.2",
    "jszip": "^3.10.2",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "firebase-admin": "^12.7.0",
    "firebase-tools": "^13.35.1",
    "jsdom": "^24.1.0",
    "playwright": "^1.63.0",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
