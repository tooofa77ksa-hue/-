rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc().data.role in ['teacher', 'admin'];
    }

    // ------------------------------------------------------------------
    // users: تُدار عبر Admin SDK (سكربت إنشاء المعلمة) حين يتوفر، ولا كتابة
    // عامة من أي عميل إطلاقًا، حتى لا يستطيع أي مستخدم منح نفسه صلاحية
    // teacher/admin.
    //
    // استثناء واحد ضيّق جدًا (bootstrap لمرة واحدة فقط): يسمح فقط للحساب
    // صاحب البريد الداخلي الثابت (dalal@teacher.shualat-lughati.internal -
    // حساب واحد بعينه، موجود مسبقًا في Firebase Authentication ومحمي بكلمة
    // مرور لا يعرفها إلا المعلمة) بإنشاء مستند دوره الخاص فقط، وبقيمة
    // "teacher" فقط، ومرة واحدة فقط (create وليس update/delete). لا يمنح
    // هذا أي صلاحية عامة: لا يمكن لأي حساب آخر أبدًا استخدام هذا المسار
    // (البريد غير قابل للتكرار في Firebase Auth، فلا يستطيع أي شخص إنشاء
    // حساب جديد بنفس البريد لانتحاله)، ولا يمكن حتى لهذا الحساب نفسه
    // تعديل الدور لاحقًا بعد إنشاء المستند مرة واحدة (create يفشل تلقائيًا
    // إن كان المستند موجودًا أصلًا في Firestore).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.auth.token.email == 'dalal@teacher.shualat-lughati.internal' &&
        request.resource.data.role == 'teacher';
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // skills: قراءة عامة (لا تحوي بيانات حساسة، تُستخدم في عرض المهارات
    // داخل اللعبة وواجهة المعلمة). الكتابة للمعلمة/الإدارة فقط.
    // ------------------------------------------------------------------
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ------------------------------------------------------------------
    // questionSets: الطالبات يقرأن فقط المجموعات المفعّلة (active == true).
    // المعلمة/الإدارة يقرأن ويكتبن كل شيء.
    // ------------------------------------------------------------------
    match /questionSets/{setId} {
      allow read: if isStaff() || resource.data.active == true;
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // questions: الطالبات يقرأن فقط الأسئلة المنشورة والمفعّلة.
    // ممنوع منعًا باتًا أي كتابة من غير المعلمة/الإدارة، وممنوع تسريب
    // إجابات الأسئلة غير المنشورة للعامة. شكل البيانات (4 اختيارات،
    // إجابة صحيحة ضمن المدى) يُتحقَّق منه في الإنشاء والتعديل معًا حتى
    // لا يُترك السؤال في حالة غير صالحة بعد أي تعديل جزئي.
    // ------------------------------------------------------------------
    function validQuestionShape() {
      return request.resource.data.correctAnswer is int &&
        request.resource.data.correctAnswer >= 0 &&
        request.resource.data.correctAnswer <= 3 &&
        request.resource.data.choices.size() == 4;
    }

    match /questions/{questionId} {
      allow read: if isStaff() ||
        (resource.data.published == true && resource.data.active == true);
      allow create: if isStaff() && validQuestionShape();
      allow update: if isStaff() && validQuestionShape();
      allow delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // gameSettings / audioSettings: إعدادات عامة غير حساسة، قراءة عامة
    // (تحتاجها /play لضبط مستوى الصوت الافتراضي ووضع اللعبة الافتراضي)،
    // والكتابة للمعلمة/الإدارة فقط.
    // ------------------------------------------------------------------
    match /gameSettings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /audioSettings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ------------------------------------------------------------------
    // students / groups: الاسم فقط (بلا هوية/جوال/بريد) - قراءة وكتابة
    // للمعلمة/الإدارة حصرًا. لا قراءة عامة إطلاقًا؛ الطالبات لا يرين هذه
    // المجموعات مباشرة، فقط أسماءهن ضمن جلسة اختبار محدَّدة يملكن رابطها
    // (انظر testSessions أدناه).
    // ------------------------------------------------------------------
    match /students/{studentId} {
      allow read, write: if isStaff();
    }

    match /groups/{groupId} {
      allow read, write: if isStaff();
    }

    // ------------------------------------------------------------------
    // testSessions: تُنشئها المعلمة فقط. القراءة الفردية بالمعرّف (get)
    // متاحة للجميع عمدًا - هذا هو "رابط الاختبار" الذي تشاركه المعلمة مع
    // الطالبة/المجموعة، ولا يكشف عن أي طالبة خارج مشاركات هذه الجلسة
    // تحديدًا. أما القوائم (list/query) فمقصورة على المعلمة فقط، فلا يمكن
    // لأي طرف تعداد كل الجلسات أو اكتشاف معرّفاتها.
    // ------------------------------------------------------------------
    match /testSessions/{sessionId} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // attempts: نتائج الاختبارات الرسمية (وليس اللعب العام - اللعب العام
    // لا يُحفظ إطلاقًا). القراءة للمعلمة فقط، لا قائمة علنية بأي نتيجة.
    //
    // الكتابة (إنشاء محاولة واحدة) متاحة بلا تسجيل دخول، لكن بتحقق صارم
    // من شكل ومنطق البيانات - فحص أمني (2026-09) كشف أن التحقق السابق
    // (نوع الحقول فقط) كان يسمح لأي حامل رابط اختبار بإرسال محاولة عبر
    // Firestore REST API مباشرة بأي نتيجة يختارها (مثلًا correctCount
    // مزيَّف أو scorePercentage=100 بلا علاقة بالإجابات الفعلية)، منتحلًا
    // اسم أي طالبة ضمن الجلسة. الشروط الإضافية أدناه تُغلق هذا:
    //   - معرّف المستند نفسه يجب أن يكون "{sessionId}_{studentId}" (لا
    //     معرّف عشوائي) - هذا يجعل أي محاولة ثانية لنفس الطالبة في نفس
    //     الجلسة "تعديلًا" (update) لا "إنشاءً" (create) من منظور قواعد
    //     الأمان، فتُرفض تلقائيًا (allow update مقصور على المعلمة) دون
    //     الحاجة لأي منطق إضافي - يمنع إغراق القاعدة بمحاولات متكررة.
    //   - studentNameSnapshot نص غير فارغ (ملاحظة: لغة قواعد Firestore لا
    //     تدعم فعليًا مطابقة "قيمة Map ضمن قائمة Maps" بشكل موثوق - جُرِّب
    //     ذلك مباشرة وسبّب خطأ تنفيذ حقيقي (Null value error) حتى في الحالة
    //     الصحيحة، فتعذّر فرض تطابق الاسم مع participants الفعلية من هنا؛
    //     يبقى هذا خطرًا متبقيًا صغيرًا موثَّقًا - أقصى ما يمكن لمشاركة
    //     خبيثة فعله عبره هو عرض اسم خاطئ لمحاولتها الوحيدة المسموحة هي،
    //     لا انتحال محاولة طالبة أخرى، لأن studentId وmعرّف المستند
    //     الحتمي أدناه يبقيان مقيَّدين تمامًا).
    //   - gameMode يجب أن يطابق نمط الجلسة نفسه.
    //   - totalQuestions محدود بعدد أسئلة الجلسة الفعلي (لا يمكن ادّعاء
    //     عدد أسئلة أكبر من الجلسة الحقيقية).
    //   - correctCount + incorrectCount == totalQuestions، وanswers.size()
    //     == totalQuestions (لا نتيجة جزئية أو متناقضة داخليًا).
    //   - scorePercentage يجب أن يساوي فعليًا التقريب الحسابي الصحيح لـ
    //     correctCount/totalQuestions×100 (نفس حساب العميل تمامًا في
    //     SessionPlayScreen.tsx) - لا يمكن تلفيق نسبة منفصلة عن العدّ.
    //   - hasOnly تمنع إضافة أي حقل إضافي غير معروف للمستند.
    // هذا لا يزال بلا Cloud Function (لا يتحقق من صحة كل إجابة فردية داخل
    // answers مقابل الأسئلة الحقيقية - قيد لغة قواعد Firestore نفسها)،
    // لكنه يرفع تكلفة أي تلاعب بشكل كبير جدًا مقارنة بالوضع السابق.
    // لا تعديل ولا حذف إلا من المعلمة.
    // ------------------------------------------------------------------
    function sessionRefFor(sid) {
      return /databases/$(database)/documents/testSessions/$(sid);
    }

    function validAttemptShape(attemptId) {
      let d = request.resource.data;
      let session = get(sessionRefFor(d.sessionId)).data;
      return d.sessionId is string &&
        exists(sessionRefFor(d.sessionId)) &&
        session.active == true &&
        attemptId == d.sessionId + '_' + d.studentId &&
        d.studentId in session.participantIds &&
        d.studentNameSnapshot is string && d.studentNameSnapshot.size() > 0 &&
        d.gameMode == session.gameMode &&
        d.totalQuestions is int && d.totalQuestions > 0 &&
        d.totalQuestions <= session.questionIds.size() &&
        d.correctCount is int && d.correctCount >= 0 &&
        d.incorrectCount is int && d.incorrectCount >= 0 &&
        d.correctCount + d.incorrectCount == d.totalQuestions &&
        d.scorePercentage is number &&
        d.scorePercentage == math.round((d.correctCount * 100.0) / d.totalQuestions) &&
        d.answers is list && d.answers.size() == d.totalQuestions &&
        d.startedAt is number && d.completedAt is number && d.durationMs is number &&
        d.createdAt is number &&
        d.keys().hasOnly([
          'sessionId', 'studentId', 'studentNameSnapshot', 'groupId', 'groupNameSnapshot',
          'startedAt', 'completedAt', 'durationMs', 'gameMode', 'skill',
          'totalQuestions', 'correctCount', 'incorrectCount', 'scorePercentage',
          'answers', 'createdAt'
        ]);
    }

    match /attempts/{attemptId} {
      allow read: if isStaff();
      allow create: if validAttemptShape(attemptId);
      allow update, delete: if isStaff();
    }


    // ==================================================================
    // «إنجازي يحكي» — كل شيء تحت apps/injazi/... معزولًا عن شُعلة لغتي
    // ------------------------------------------------------------------
    // مبدأ واحد: الدور يُقرأ من apps/injazi/users/{uid} فقط، ولا يستطيع
    // أي عميل كتابة ذلك المستند إطلاقًا إلا مشرفة موجودة مسبقًا — فلا
    // يمكن لأي حساب أن يرقّي نفسه.
    // ==================================================================

    function izUser() {
      return get(/databases/$(database)/documents/apps/injazi/users/$(request.auth.uid)).data;
    }

    function izHasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/apps/injazi/users/$(request.auth.uid));
    }

    function izActive() {
      return izHasProfile() && izUser().get('active', true) == true;
    }

    function izRole() {
      return izActive() ? izUser().role : 'guest';
    }

    function izIsAdmin() {
      return izRole() == 'admin';
    }

    // ------------------------------------------------------------------
    // روابط المعلمات.
    // المعلمة لا تملك بريدًا ولا كلمة مرور: تفتح رابطًا فيه رمز عشوائي
    // (١٢٨ بت) هو معرّف مستند الدعوة نفسه، فيسجّلها النظام دخولًا مجهولًا
    // ثم تُنشئ ملف صلاحيات مطابقًا لما في الدعوة حرفيًا.
    //
    // الرابط قدرة (capability): من يملكه يقيّم مواد تلك المعلمة — وهذا هو
    // المطلوب بالضبط. ولذلك:
    //   • لا تعداد للروابط إطلاقًا (list للمشرفة وحدها)، فلا يُخمَّن رمز.
    //   • الصلاحية تُفحص حيّة عند كل كتابة: حذف الدعوة يقطعها فورًا في كل
    //     جهاز فُتح به الرابط، لا عند انتهاء جلسة ولا بعد تسجيل خروج.
    //   • ما يمنحه الرابط محدود سلفًا: تقييم مواد تلك المعلمة لا غير.
    // ------------------------------------------------------------------
    function izInviteRef(code) {
      return /databases/$(database)/documents/apps/injazi/invites/$(code);
    }

    function izInvite(code) {
      return get(izInviteRef(code)).data;
    }

    /** دعوة قائمة وفعّالة. */
    function izInviteLive(code) {
      return code is string && exists(izInviteRef(code)) && izInvite(code).active == true;
    }

    // ------------------------------------------------------------------
    // روابط الطالبات.
    // رابط واحد لكل طالبة تفتحه هي وولي أمرها معًا — لا رابط منفصل لكل
    // منهما. يمنح تعديل ملف تلك الطالبة وحدها: لا لوحة إدارة، ولا أدوات
    // تقييم، ولا مساس بملف أي طالبة أخرى مهما عُبث بالرابط.
    // ------------------------------------------------------------------
    function izLinkRef(code) {
      return /databases/$(database)/documents/apps/injazi/studentLinks/$(code);
    }

    function izLink(code) {
      return get(izLinkRef(code)).data;
    }

    function izLinkLive(code) {
      return code is string && exists(izLinkRef(code)) && izLink(code).active == true;
    }

    /**
     * ملف صلاحيات لم يأتِ من رابط يبقى كما هو؛ وما جاء من رابط يسقط
     * لحظة إلغاء الرابط. هذا ما يجعل زر «إلغاء الرابط» إلغاءً حقيقيًا،
     * للمعلمة ولرابط الطالبة على السواء.
     */
    function izGrantLive() {
      return (!('inviteCode' in izUser()) || izInviteLive(izUser().inviteCode))
        && (!('linkCode' in izUser()) || izLinkLive(izUser().linkCode));
    }

    /**
     * المطالبة برابط الطالبة: دور ولي أمر، ولطالبة واحدة بعينها هي التي
     * في الرابط لا غير — فلا يضيف حاملُ رابطٍ طالبةً أخرى إلى قائمته.
     */
    function izClaimsLink(uid) {
      let d = request.resource.data;
      return isSignedIn() && request.auth.uid == uid &&
        d.keys().hasAll(['role', 'active', 'linkCode', 'studentIds']) &&
        d.role == 'parent' &&
        d.active == true &&
        izLinkLive(d.linkCode) &&
        d.studentIds == [izLink(d.linkCode).studentId];
    }

    function izIsTeacher() {
      return izRole() == 'teacher' && izGrantLive();
    }

    /**
     * المطالبة بالدعوة: تُقبل كتابة ملف الصلاحيات من الحساب نفسه فقط،
     * وبدور teacher فقط، وبمعلمة ومواد مطابقة لما في الدعوة تمامًا — فلا
     * يستطيع حامل رابط مادة واحدة أن يمنح نفسه مواد زميلاتها.
     */
    function izClaimsInvite(uid) {
      let d = request.resource.data;
      return isSignedIn() && request.auth.uid == uid &&
        // الحقول المطلوبة أولًا: قراءة حقل غائب خطأ تنفيذ لا رفضًا نظيفًا،
        // والرفض النظيف هو ما نريد قراءته في السجلّ لاحقًا.
        d.keys().hasAll(['role', 'active', 'inviteCode', 'teacherId', 'subjectIds']) &&
        d.role == 'teacher' &&
        d.active == true &&
        izInviteLive(d.inviteCode) &&
        d.teacherId == izInvite(d.inviteCode).teacherId &&
        d.subjectIds == izInvite(d.inviteCode).subjectIds;
    }

    // ولي أمر هذه الطالبة بالذات — لا أي طالبة أخرى. والصلاحية مشروطة
    // ببقاء رابطها صالحًا إن كان الدخول جاء من رابط.
    function izIsParentOf(studentId) {
      return izRole() == 'parent' && izGrantLive()
        && studentId in izUser().get('studentIds', []);
    }

    function izCanEditStudent(studentId) {
      return izIsAdmin() || izIsParentOf(studentId);
    }

    // المعلمة تقيّم موادها فقط. subjectIds مخزّنة في ملف الصلاحيات نفسه
    // حتى لا تحتاج القاعدة قراءتين متسلسلتين.
    function izTeaches(subjectId) {
      return izIsTeacher() && subjectId in izUser().get('subjectIds', []);
    }

    // الخصوصية: public للجميع، school لأي حساب فعّال، private للمالكة
    // والإدارة وهيئة التدريس.
    function izCanRead(data, studentId) {
      return data.get('visibility', 'public') == 'public'
        || izIsAdmin() || izIsTeacher()
        || (data.get('visibility', 'public') == 'school' && izActive())
        || izCanEditStudent(studentId);
    }

    match /apps/injazi/users/{uid} {
      // كل مستخدمة تقرأ ملفها، والإدارة تقرأ الجميع. المعلمة لا تقرأ
      // ملفات غيرها: مستندات أولياء الأمور تحمل بريدهم، ولا حاجة لها به —
      // اسم من قيّم يأتي من التقييم نفسه ومن مجموعة المعلمات المعلنة.
      allow read: if isSignedIn() && (request.auth.uid == uid || izIsAdmin());

      // الإنشاء: للمشرفة، أو لمن تفتح رابطها لأول مرة على جهازها —
      // معلمةً كانت أو طالبةً/ولي أمر.
      allow create: if izIsAdmin() || izClaimsInvite(uid) || izClaimsLink(uid);
      // التعديل والحذف للمشرفة وحدها — فلا يرقّي أحد نفسه بعد الإنشاء.
      allow update, delete: if izIsAdmin();
    }

    match /apps/injazi/invites/{code} {
      // القراءة الفردية بالمعرّف فقط: المعرّف هو السر، ومن يعرفه يملك
      // الرابط أصلًا. لا list إلا للمشرفة، فلا يُكتشف رمز بالتعداد.
      allow get: if isSignedIn();
      allow list: if izIsAdmin();
      allow create, update, delete: if izIsAdmin();
    }

    match /apps/injazi/studentLinks/{code} {
      // نفس المبدأ: قراءة بالمعرّف وحده، ولا تعداد إلا للمشرفة — فلا
      // تستطيع طالبة اكتشاف رابط زميلتها بأي استعلام.
      allow get: if isSignedIn();
      allow list: if izIsAdmin();
      allow create, update, delete: if izIsAdmin();
    }

    match /apps/injazi/students/{studentId} {
      // بطاقة الطالبة (الاسم والصورة) عامة عمدًا: الصفحة الرئيسية مفتوحة
      // ويجب أن تعرض المعرض دون تسجيل دخول.
      allow read: if true;
      allow create, delete: if izIsAdmin();
      allow update: if izCanEditStudent(studentId)
        // ولي الأمر لا يغيّر ترتيب الظهور ولا يفعّل/يعطّل الملف.
        && (izIsAdmin() || !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['order', 'active']));
    }

    match /apps/injazi/teachers/{teacherId} {
      allow read: if true;
      allow write: if izIsAdmin();
    }

    match /apps/injazi/subjects/{subjectId} {
      allow read: if true;
      allow write: if izIsAdmin();
    }

    match /apps/injazi/projects/{projectId} {
      allow read: if izCanRead(resource.data, resource.data.studentId);
      allow create: if izCanEditStudent(request.resource.data.studentId);
      allow update: if izCanEditStudent(resource.data.studentId)
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if izCanEditStudent(resource.data.studentId);
    }

    match /apps/injazi/achievements/{achievementId} {
      allow read: if izCanRead(resource.data, resource.data.studentId);
      allow create: if izCanEditStudent(request.resource.data.studentId);
      allow update: if izCanEditStudent(resource.data.studentId)
        && request.resource.data.studentId == resource.data.studentId;
      allow delete: if izCanEditStudent(resource.data.studentId);
    }

    match /apps/injazi/evaluations/{evaluationId} {
      // التقييم يظهر في ملف الطالبة العام، فقراءته عامة.
      allow read: if true;
      // المعلمة تكتب تقييم مادتها فقط، وباسمها هي لا باسم زميلتها.
      allow create, update: if izIsAdmin()
        || (izTeaches(request.resource.data.subjectId)
            && request.resource.data.teacherId == izUser().get('teacherId', request.auth.uid)
            && request.resource.data.stars is int
            && request.resource.data.stars >= 1
            && request.resource.data.stars <= 5
            && request.resource.data.badge is bool
            && request.resource.data.status in ['excellent', 'complete', 'needs-revision']);
      allow delete: if izIsAdmin();
    }

    match /apps/injazi/settings/{docId} {
      allow read: if true;
      allow write: if izIsAdmin();
    }

    match /apps/injazi/activityLogs/{logId} {
      // السجل للإدارة وحدها قراءةً؛ الكتابة لأي حساب فعّال لأنه أثر جانبي
      // لعملية مسموح بها أصلًا. لا تعديل ولا حذف: سجل لا يُزوَّر.
      allow read: if izIsAdmin();
      allow create: if izActive();
      allow update, delete: if false;
    }


    // ------------------------------------------------------------------
    // media: الصور محفوظة داخل Firestore لا في Cloud Storage (قرار مقصود:
    // التخزين السحابي صار يتطلب بطاقة بنكية، والمنصة مدرسية مجانية).
    // كل صورة مستند مستقل حتى لا تنتفخ مستندات الطالبات ولا تُحمَّل الصور
    // مع كل قراءة للقائمة.
    // ------------------------------------------------------------------
    match /apps/injazi/media/{mediaId} {
      // القراءة عامة: الصور تُعرض في صفحة مفتوحة للجميع.
      allow read: if true;

      allow create: if izActive()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.data is string
        // حد مستند Firestore مليون بايت؛ نبقى تحته بهامش آمن.
        && request.resource.data.data.size() < 960000
        && request.resource.data.mime in ['image/webp', 'image/jpeg', 'image/png', 'image/avif'];

      // الصورة غير قابلة للتعديل: الاستبدال يعني صورة جديدة وحذف القديمة،
      // فلا يمكن تبديل محتوى صورة يشير إليها مستند طالبة أخرى.
      allow update: if false;

      allow delete: if izIsAdmin() || resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
