rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isStaff() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        userDoc().data.role in ['teacher', 'admin'];
    }

    // ------------------------------------------------------------------
    // users: تُدار عبر Admin SDK (سكربت إنشاء المعلمة) حين يتوفر، ولا كتابة
    // عامة من أي عميل إطلاقًا، حتى لا يستطيع أي مستخدم منح نفسه صلاحية
    // teacher/admin.
    //
    // استثناء واحد ضيّق جدًا (bootstrap لمرة واحدة فقط): يسمح فقط للحساب
    // صاحب البريد الداخلي الثابت (dalal@teacher.shualat-lughati.internal -
    // حساب واحد بعينه، موجود مسبقًا في Firebase Authentication ومحمي بكلمة
    // مرور لا يعرفها إلا المعلمة) بإنشاء مستند دوره الخاص فقط، وبقيمة
    // "teacher" فقط، ومرة واحدة فقط (create وليس update/delete). لا يمنح
    // هذا أي صلاحية عامة: لا يمكن لأي حساب آخر أبدًا استخدام هذا المسار
    // (البريد غير قابل للتكرار في Firebase Auth، فلا يستطيع أي شخص إنشاء
    // حساب جديد بنفس البريد لانتحاله)، ولا يمكن حتى لهذا الحساب نفسه
    // تعديل الدور لاحقًا بعد إنشاء المستند مرة واحدة (create يفشل تلقائيًا
    // إن كان المستند موجودًا أصلًا في Firestore).
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() &&
        request.auth.uid == uid &&
        request.auth.token.email == 'dalal@teacher.shualat-lughati.internal' &&
        request.resource.data.role == 'teacher';
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // skills: قراءة عامة (لا تحوي بيانات حساسة، تُستخدم في عرض المهارات
    // داخل اللعبة وواجهة المعلمة). الكتابة للمعلمة/الإدارة فقط.
    // ------------------------------------------------------------------
    match /skills/{skillId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ------------------------------------------------------------------
    // questionSets: الطالبات يقرأن فقط المجموعات المفعّلة (active == true).
    // المعلمة/الإدارة يقرأن ويكتبن كل شيء.
    // ------------------------------------------------------------------
    match /questionSets/{setId} {
      allow read: if isStaff() || resource.data.active == true;
      allow create: if isStaff();
      allow update, delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // questions: الطالبات يقرأن فقط الأسئلة المنشورة والمفعّلة.
    // ممنوع منعًا باتًا أي كتابة من غير المعلمة/الإدارة، وممنوع تسريب
    // إجابات الأسئلة غير المنشورة للعامة. شكل البيانات (4 اختيارات،
    // إجابة صحيحة ضمن المدى) يُتحقَّق منه في الإنشاء والتعديل معًا حتى
    // لا يُترك السؤال في حالة غير صالحة بعد أي تعديل جزئي.
    // ------------------------------------------------------------------
    function validQuestionShape() {
      return request.resource.data.correctAnswer is int &&
        request.resource.data.correctAnswer >= 0 &&
        request.resource.data.correctAnswer <= 3 &&
        request.resource.data.choices.size() == 4;
    }

    match /questions/{questionId} {
      allow read: if isStaff() ||
        (resource.data.published == true && resource.data.active == true);
      allow create: if isStaff() && validQuestionShape();
      allow update: if isStaff() && validQuestionShape();
      allow delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // gameSettings / audioSettings: إعدادات عامة غير حساسة، قراءة عامة
    // (تحتاجها /play لضبط مستوى الصوت الافتراضي ووضع اللعبة الافتراضي)،
    // والكتابة للمعلمة/الإدارة فقط.
    // ------------------------------------------------------------------
    match /gameSettings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /audioSettings/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // ------------------------------------------------------------------
    // students / groups: الاسم فقط (بلا هوية/جوال/بريد) - قراءة وكتابة
    // للمعلمة/الإدارة حصرًا. لا قراءة عامة إطلاقًا؛ الطالبات لا يرين هذه
    // المجموعات مباشرة، فقط أسماءهن ضمن جلسة اختبار محدَّدة يملكن رابطها
    // (انظر testSessions أدناه).
    // ------------------------------------------------------------------
    match /students/{studentId} {
      allow read, write: if isStaff();
    }

    match /groups/{groupId} {
      allow read, write: if isStaff();
    }

    // ------------------------------------------------------------------
    // testSessions: تُنشئها المعلمة فقط. القراءة الفردية بالمعرّف (get)
    // متاحة للجميع عمدًا - هذا هو "رابط الاختبار" الذي تشاركه المعلمة مع
    // الطالبة/المجموعة، ولا يكشف عن أي طالبة خارج مشاركات هذه الجلسة
    // تحديدًا. أما القوائم (list/query) فمقصورة على المعلمة فقط، فلا يمكن
    // لأي طرف تعداد كل الجلسات أو اكتشاف معرّفاتها.
    // ------------------------------------------------------------------
    match /testSessions/{sessionId} {
      allow get: if true;
      allow list: if isStaff();
      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // attempts: نتائج الاختبارات الرسمية (وليس اللعب العام - اللعب العام
    // لا يُحفظ إطلاقًا). القراءة للمعلمة فقط، لا قائمة علنية بأي نتيجة.
    //
    // الكتابة (إنشاء محاولة واحدة) متاحة بلا تسجيل دخول، لكن بتحقق صارم
    // من شكل ومنطق البيانات - فحص أمني (2026-09) كشف أن التحقق السابق
    // (نوع الحقول فقط) كان يسمح لأي حامل رابط اختبار بإرسال محاولة عبر
    // Firestore REST API مباشرة بأي نتيجة يختارها (مثلًا correctCount
    // مزيَّف أو scorePercentage=100 بلا علاقة بالإجابات الفعلية)، منتحلًا
    // اسم أي طالبة ضمن الجلسة. الشروط الإضافية أدناه تُغلق هذا:
    //   - معرّف المستند نفسه يجب أن يكون "{sessionId}_{studentId}" (لا
    //     معرّف عشوائي) - هذا يجعل أي محاولة ثانية لنفس الطالبة في نفس
    //     الجلسة "تعديلًا" (update) لا "إنشاءً" (create) من منظور قواعد
    //     الأمان، فتُرفض تلقائيًا (allow update مقصور على المعلمة) دون
    //     الحاجة لأي منطق إضافي - يمنع إغراق القاعدة بمحاولات متكررة.
    //   - studentNameSnapshot نص غير فارغ (ملاحظة: لغة قواعد Firestore لا
    //     تدعم فعليًا مطابقة "قيمة Map ضمن قائمة Maps" بشكل موثوق - جُرِّب
    //     ذلك مباشرة وسبّب خطأ تنفيذ حقيقي (Null value error) حتى في الحالة
    //     الصحيحة، فتعذّر فرض تطابق الاسم مع participants الفعلية من هنا؛
    //     يبقى هذا خطرًا متبقيًا صغيرًا موثَّقًا - أقصى ما يمكن لمشاركة
    //     خبيثة فعله عبره هو عرض اسم خاطئ لمحاولتها الوحيدة المسموحة هي،
    //     لا انتحال محاولة طالبة أخرى، لأن studentId وmعرّف المستند
    //     الحتمي أدناه يبقيان مقيَّدين تمامًا).
    //   - gameMode يجب أن يطابق نمط الجلسة نفسه.
    //   - totalQuestions محدود بعدد أسئلة الجلسة الفعلي (لا يمكن ادّعاء
    //     عدد أسئلة أكبر من الجلسة الحقيقية).
    //   - correctCount + incorrectCount == totalQuestions، وanswers.size()
    //     == totalQuestions (لا نتيجة جزئية أو متناقضة داخليًا).
    //   - scorePercentage يجب أن يساوي فعليًا التقريب الحسابي الصحيح لـ
    //     correctCount/totalQuestions×100 (نفس حساب العميل تمامًا في
    //     SessionPlayScreen.tsx) - لا يمكن تلفيق نسبة منفصلة عن العدّ.
    //   - hasOnly تمنع إضافة أي حقل إضافي غير معروف للمستند.
    // هذا لا يزال بلا Cloud Function (لا يتحقق من صحة كل إجابة فردية داخل
    // answers مقابل الأسئلة الحقيقية - قيد لغة قواعد Firestore نفسها)،
    // لكنه يرفع تكلفة أي تلاعب بشكل كبير جدًا مقارنة بالوضع السابق.
    // لا تعديل ولا حذف إلا من المعلمة.
    // ------------------------------------------------------------------
    function sessionRefFor(sid) {
      return /databases/$(database)/documents/testSessions/$(sid);
    }

    function validAttemptShape(attemptId) {
      let d = request.resource.data;
      let session = get(sessionRefFor(d.sessionId)).data;
      return d.sessionId is string &&
        exists(sessionRefFor(d.sessionId)) &&
        session.active == true &&
        attemptId == d.sessionId + '_' + d.studentId &&
        d.studentId in session.participantIds &&
        d.studentNameSnapshot is string && d.studentNameSnapshot.size() > 0 &&
        d.gameMode == session.gameMode &&
        d.totalQuestions is int && d.totalQuestions > 0 &&
        d.totalQuestions <= session.questionIds.size() &&
        d.correctCount is int && d.correctCount >= 0 &&
        d.incorrectCount is int && d.incorrectCount >= 0 &&
        d.correctCount + d.incorrectCount == d.totalQuestions &&
        d.scorePercentage is number &&
        d.scorePercentage == math.round((d.correctCount * 100.0) / d.totalQuestions) &&
        d.answers is list && d.answers.size() == d.totalQuestions &&
        d.startedAt is number && d.completedAt is number && d.durationMs is number &&
        d.createdAt is number &&
        d.keys().hasOnly([
          'sessionId', 'studentId', 'studentNameSnapshot', 'groupId', 'groupNameSnapshot',
          'startedAt', 'completedAt', 'durationMs', 'gameMode', 'skill',
          'totalQuestions', 'correctCount', 'incorrectCount', 'scorePercentage',
          'answers', 'createdAt'
        ]);
    }

    match /attempts/{attemptId} {
      allow read: if isStaff();
      allow create: if validAttemptShape(attemptId);
      allow update, delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
