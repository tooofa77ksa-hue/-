rules_version = '2';

// ====================================================================
// قواعد Firebase Storage — «إنجازي يحكي»
// --------------------------------------------------------------------
// الملكية تُثبَت من المسار نفسه لا من قراءة في Firestore:
//
//     <النطاق>/<uid المالك>/<النوع>/<الملف>
//
// فتقارن القاعدة request.auth.uid بجزء ثابت من المسار. السبب قرار
// هندسي مقصود وليس اختصارًا:
//
//   • firestore.get() داخل قواعد Storage لا يُنفَّذ في المحاكي إطلاقًا
//     (تحقّقنا عمليًا: كل كتابة مصرّح بها تُرفَض). قاعدة كهذه تعني رفعًا
//     معطّلًا في التطوير وقواعد أمنية لا يمكن اختبارها قبل النشر —
//     وهذا أخطر من الثغرة التي تحاول سدّها.
//   • ربط الملف بطالبة بعينها محسوم في Firestore أصلًا: لا أحد يستطيع
//     كتابة مستند طالبة أخرى (٣٢ اختبارًا تثبت ذلك)، فالملف المرفوع
//     خارج صلاحية صاحبه لا يمكن أن يظهر في أي ملف إنجاز.
//   • القراءة عامة عمدًا: صور الملفات تُعرض في صفحة عامة، وروابط
//     التنزيل تحمل رمزًا عشوائيًا لا يُخمَّن.
//
// الحدود (النوع والحجم) مكرّرة هنا رغم وجودها في الواجهة، لأن فحص
// المتصفح تجميلي ويُتجاوَز بطلب مباشر إلى واجهة التخزين.
// ====================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(ownerUid) {
      return request.auth != null && request.auth.uid == ownerUid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp|gif|avif)');
    }

    function isDoc() {
      return request.resource.contentType == 'application/pdf';
    }

    function isVideo() {
      return request.resource.contentType.matches('video/(mp4|webm|quicktime)');
    }

    function isAudio() {
      return request.resource.contentType.matches('audio/(mpeg|mp3|wav|ogg|aac|x-m4a)');
    }

    function under(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ---------------- ملفات الطالبات ----------------
    // مشاريع، إنجازات، شهادات، صور الملف الشخصي.
    match /students/{studentId}/{ownerUid}/{allPaths=**} {
      allow read: if true;

      allow create, update: if isOwner(ownerUid)
        && ((isImage() && under(8)) || (isDoc() && under(20)) || (isVideo() && under(20)));

      // المعلمة لا تملك أي مسار تحت الطالبات، فلا تستطيع حذف عمل طالبة
      // بأي حال — الشرط نفسه يمنعها دون استثناء خاص.
      allow delete: if isOwner(ownerUid);
    }

    // ---------------- ملفات المنصة ----------------
    // الشعار وصور المعلمات والأغنية — يرفعها من يملك مسارها (المشرفة).
    match /platform/{ownerUid}/settings/audio/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(ownerUid) && isAudio() && under(15);
    }

    match /platform/{ownerUid}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(ownerUid) && isImage() && under(8);
    }

    // ---------------- منع افتراضي ----------------
    // أي مسار خارج المخطّط أعلاه مغلق تمامًا للجميع.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
