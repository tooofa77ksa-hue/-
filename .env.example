# انسخي هذا الملف إلى .env - لا تضعي أي Secret حقيقي في هذا الملف
# (.env.example) نفسه، فهو الوحيد المحفوظ في git.

# ============================================================
# للتطوير المحلي عبر Firebase Emulator Suite (موصى به، بلا Secrets حقيقية)
# ============================================================
# 1) شغّلي: npm run emulator
# 2) في .env: فعّلي الوضع التالي وضعي أي قيم نصية (المحاكي لا يتحقق منها):
#
# VITE_FIREBASE_API_KEY=emulator-fake-key
# VITE_FIREBASE_AUTH_DOMAIN=localhost
# VITE_FIREBASE_PROJECT_ID=demo-shualat-lughati
# VITE_FIREBASE_STORAGE_BUCKET=demo-shualat-lughati.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
# VITE_FIREBASE_APP_ID=1:000000000000:web:emulator
# VITE_USE_FIREBASE_EMULATORS=true

# ============================================================
# لمشروع Firebase حقيقي (عند النشر الفعلي)
# ============================================================
# من Firebase Console -> Project Settings -> General -> Your apps -> SDK
# setup and configuration. هذه القيم عامة (Public) وآمنة للعميل بطبيعتها؛
# الحماية الحقيقية للبيانات تأتي من Firestore Security Rules وليس من إخفاء
# هذه القيم.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false

# ------------------------------------------------------------------
# «إنجازي يحكي» يستخدم نفس إعدادات Firebase أعلاه ويضيف Storage.
# تأكدي من ضبط VITE_FIREBASE_STORAGE_BUCKET (اسم الحاوية في Firebase).
#
# للتطوير على المحاكيات المحلية فقط (لا تُستخدَم في الإنتاج إطلاقًا —
# البناء الإنتاجي يحذف هذا الشرط بالكامل، ولا يبقى في الحزمة أي عنوان
# محاكي):
# VITE_USE_FIREBASE_EMULATORS=true
#
# ------------------------------------------------------------------
# App Check (اختياري لكنه موصى به بشدة في الإنتاج)
# يمنع استهلاك قاعدة البيانات والتخزين من خارج الموقع نفسه.
# المفتاح يُنشأ من: Firebase Console ← App Check ← تسجيل تطبيق الويب
# بمزوّد reCAPTCHA v3. إن تُرك فارغًا يعمل الموقع بالقواعد الأمنية وحدها.
# VITE_FIREBASE_APPCHECK_SITE_KEY=
#
# رمز تصحيح للتطوير على جهاز حقيقي (لا يُضبَط في الإنتاج إطلاقًا):
# VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=
