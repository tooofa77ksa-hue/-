{
  "name": "shualat-lughati",
  "private": true,
  "version": "1.0.0",
  "description": "شُعلة لغتي - منصة تعليمية عربية تفاعلية لمادة لغتي للصف الثالث الابتدائي",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "seed": "tsx scripts/seed.ts",
    "create-teacher": "tsx scripts/createTeacher.ts",
    "emulator": "firebase emulators:start --only auth,firestore,storage",
    "test:rules": "firebase emulators:exec --only firestore,auth,storage \"vitest run tests/rules\"",
    "deploy:rules": "firebase deploy --project production --only firestore:rules,firestore:indexes,storage",
    "deploy:hosting": "firebase deploy --project production --only hosting",
    "injazi:seed": "tsx scripts/seedInjazi.ts",
    "test:e2e": "sh scripts/test-injazi-e2e.sh",
    "injazi:bootstrap": "tsx scripts/bootstrapProduction.ts",
    "injazi:deploy:rules": "firebase deploy --project injazi --only firestore:rules,firestore:indexes,storage"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "exceljs": "^4.4.0",
    "firebase": "^12.18.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "phaser": "^3.86.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-easy-crop": "^6.2.3",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "firebase-admin": "^13.0.0",
    "firebase-tools": "^15.29.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}