{
  "name": "shualat-lughati",
  "private": true,
  "version": "1.0.0",
  "description": "شُعلة لغتي - منصة تعليمية عربية تفاعلية لمادة لغتي للصف الثالث الابتدائي",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --max-warnings 0",
    "typecheck": "tsc -b --noEmit",
    "seed": "tsx scripts/seed.ts",
    "create-teacher": "tsx scripts/createTeacher.ts",
    "emulator": "firebase emulators:start --only auth,firestore",
    "test:rules": "firebase emulators:exec --only firestore,auth \"vitest run tests/rules\"",
    "deploy:rules": "firebase deploy --project production --only firestore:rules,firestore:indexes",
    "deploy:hosting": "firebase deploy --project production --only hosting"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.18.0",
    "phaser": "^3.86.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^15.29.0",
    "playwright": "^1.63.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  }
}
